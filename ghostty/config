font-family = "JetBrainsMono Nerd Font"

background=#000000
foreground=#FFFFFF
cursor-color=#FFFFFF
cursor-style=bar
selection-background=#FFBAF3
bold-is-bright=true
palette = 0=#000000
palette = 1=#FFC4BA
palette = 2=#33FF00
palette = 3=#DDDE00
palette = 4=#B9D7FF
palette = 5=#FFBAF3
palette = 6=#00F2F2
palette = 7=#D0D0D0
palette = 8=#808080
palette = 9=#FFC4BA
palette = 10=#33FF00
palette = 11=#DDDE00
palette = 12=#B9D7FF
palette = 13=#FFBAF3
palette = 14=#00F2F2
palette = 15=#FFFFFF
background-opacity=0.85
background-blur=16

font-size=16
font-thicken=true
font-thicken-strength=1
adjust-cell-height=1
window-padding-x = 20
window-padding-y = 20
window-padding-balance = true


macos-titlebar-style = hidden
macos-option-as-alt = true


keybind = super+n=unbind

# Focus between splits (cmd+ctrl+hjkl)
keybind = super+ctrl+h=goto_split:left
keybind = super+ctrl+j=goto_split:down
keybind = super+ctrl+k=goto_split:up
keybind = super+ctrl+l=goto_split:right

# Create split (cmd+ctrl+shift+hjkl)
keybind = super+ctrl+shift+h=new_split:left
keybind = super+ctrl+shift+j=new_split:down
keybind = super+ctrl+shift+k=new_split:up
keybind = super+ctrl+shift+l=new_split:right
